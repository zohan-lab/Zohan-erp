rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 1. User Profiles (/users/{userId}) ─────────────────────────
    match /users/{userId} {
      allow read, write: if true;
    }

    // ─── 2. Tenant Data Partitions (/tenants/{companyId}/partitions/{partitionId}) ──
    match /tenants/{companyId}/partitions/{partitionId} {
      allow read, write: if true;
    }

    // ─── Legacy Tenant Snapshots ─────────────────────────────────────
    match /tenants/{companyId}/snapshots/{tenantKey} {
      allow read, write: if true;
    }

    // ─── 3. Businesses (/businesses/{businessId}) ────────────────────
    match /businesses/{businessId} {
      allow read, write: if true;
    }

    // ─── 4. Audit Logs (/audit_logs/{logId}) ─────────────────────────
    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // ─── 5. Default Catch-All ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
